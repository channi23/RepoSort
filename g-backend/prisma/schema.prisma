generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * Core Project Models
 * =========================
 */

model Project {
  id        String   @id @default(uuid())
  name      String?
  repoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repoSnapshots  RepoSnapshot[]
  graphSnapshots GraphSnapshot[]
  risks          Risk[]
  plans Plan[]
  runs Run[]
}

model RepoSnapshot {
  id              String   @id @default(uuid())
  projectId       String
  createdAt       DateTime @default(now())
  sandboxRepoPath String
  branch          String?
  commitSha       String?
  isMonorepo      Boolean  @default(false)
  packageManager  String?
  runtime         String?
  testFramework   String?
  fileTreeJson    Json?
  configJson      Json?

  project        Project         @relation(fields: [projectId], references: [id])
  graphSnapshots GraphSnapshot[]
  runs Run[]
}

/**
 * =========================
 * Graph Models
 * =========================
 */

model GraphSnapshot {
  id             String   @id @default(uuid())
  projectId      String
  repoSnapshotId String
  createdAt      DateTime @default(now())

  nodeCount Int @default(0)
  edgeCount Int @default(0)

  project      Project      @relation(fields: [projectId], references: [id])
  repoSnapshot RepoSnapshot @relation(fields: [repoSnapshotId], references: [id])

  nodes Node[]
  edges Edge[]
  risks Risk[]
  plans Plan[]
}

/**
 * =========================
 * Graph Primitives
 * =========================
 */

enum NodeType {
  PROJECT
  DIR
  FILE
  MODULE
  FUNCTION
  DEPENDENCY
  CONFIG
  SERVICE
}

enum EdgeType {
  CONTAINS
  IMPORTS
  DEPENDS_ON
  CALLS
}

model Node {
  id              String   @id @default(uuid())
  graphSnapshotId String
  type            NodeType
  label           String
  path            String?
  meta            Json?

  graphSnapshot GraphSnapshot @relation(fields: [graphSnapshotId], references: [id])
  risks         RiskOnNode[]

  @@index([graphSnapshotId])
}

model Edge {
  id              String   @id @default(uuid())
  graphSnapshotId String
  type            EdgeType
  fromNodeId      String
  toNodeId        String
  meta            Json?

  graphSnapshot GraphSnapshot @relation(fields: [graphSnapshotId], references: [id])

  @@index([graphSnapshotId])
}

enum RiskType {
  STRUCTURAL
  SECURITY
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Risk {
  id              String       @id @default(uuid())
  projectId       String
  graphSnapshotId String
  type            RiskType
  severity        RiskSeverity
  title           String
  description     String
  ruleId          String?
  meta            Json?
  createdAt       DateTime     @default(now())

  project       Project       @relation(fields: [projectId], references: [id])
  graphSnapshot GraphSnapshot @relation(fields: [graphSnapshotId], references: [id])

  nodes RiskOnNode[]
}

model RiskOnNode {
  riskId String
  nodeId String

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([riskId, nodeId])
  @@index([nodeId])
}
enum PlanStatus {
  DRAFT
  APPROVED
}

enum PlanStepType {
  REFACTOR
  HARDEN
  ADD_TESTS
  CLEANUP
  DOCS
}

model Plan {
  id              String      @id @default(uuid())
  projectId       String
  graphSnapshotId String

  prompt          String
  selectedNodeIds Json
  status          PlanStatus  @default(DRAFT)

  createdAt       DateTime    @default(now())

  steps           PlanStep[]

  project         Project       @relation(fields: [projectId], references: [id])
  graphSnapshot   GraphSnapshot  @relation(fields: [graphSnapshotId], references: [id])

  @@index([projectId, createdAt])
  @@index([graphSnapshotId])
  runs Run[]
}

model PlanStep {
  id            String       @id @default(uuid())
  planId        String
  order         Int
  type          PlanStepType
  title         String
  rationale     String?
  targetNodeIds Json
  meta          Json?

  plan          Plan @relation(fields: [planId], references: [id])

  @@index([planId, order])
}
enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Run {
  id            String    @id @default(uuid())
  projectId     String
  repoSnapshotId String
  planId        String

  status        RunStatus @default(QUEUED)
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  sandboxRepoPath String?  // run repo path
  installOk     Boolean?
  buildOk       Boolean?
  testOk        Boolean?
  installStdout String?
  installStderr String?
  buildStdout   String?
  buildStderr   String?
  testStdout    String?
  testStderr    String?

  patch         Patch?

  project       Project     @relation(fields: [projectId], references: [id])
  repoSnapshot  RepoSnapshot @relation(fields: [repoSnapshotId], references: [id])
  plan          Plan        @relation(fields: [planId], references: [id])

  @@index([projectId, createdAt])
  @@index([repoSnapshotId])
  @@index([planId])
}

model Patch {
  id        String   @id @default(uuid())
  runId     String   @unique
  path      String
  createdAt DateTime @default(now())

  run       Run      @relation(fields: [runId], references: [id])
}
