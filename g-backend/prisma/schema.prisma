generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * Core Project Models
 * =========================
 */

model Project {
  id        String   @id @default(uuid())
  name      String?
  repoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repoSnapshots  RepoSnapshot[]
  graphSnapshots GraphSnapshot[]
}

model RepoSnapshot {
  id              String   @id @default(uuid())
  projectId       String
  createdAt       DateTime @default(now())
  sandboxRepoPath String
  branch          String?
  commitSha       String?
  isMonorepo      Boolean  @default(false)
  packageManager  String?
  runtime         String?
  testFramework   String?
  fileTreeJson    Json?
  configJson      Json?

  project        Project         @relation(fields: [projectId], references: [id])
  graphSnapshots GraphSnapshot[] // ✅ REQUIRED back-relation
}

/**
 * =========================
 * Graph Models
 * =========================
 */

model GraphSnapshot {
  id             String   @id @default(uuid())
  projectId      String
  repoSnapshotId String
  createdAt      DateTime @default(now())

  nodeCount Int @default(0)
  edgeCount Int @default(0)

  project      Project      @relation(fields: [projectId], references: [id])
  repoSnapshot RepoSnapshot @relation(fields: [repoSnapshotId], references: [id])

  nodes Node[]
  edges Edge[]
}

/**
 * =========================
 * Graph Primitives
 * =========================
 */

enum NodeType {
  PROJECT
  DIR
  FILE
  MODULE
  FUNCTION
  DEPENDENCY
  CONFIG
  SERVICE
}

enum EdgeType {
  CONTAINS
  IMPORTS
  DEPENDS_ON
  CALLS
}

model Node {
  id              String   @id @default(uuid())
  graphSnapshotId String
  type            NodeType
  label           String
  path            String?
  meta            Json?

  graphSnapshot GraphSnapshot @relation(fields: [graphSnapshotId], references: [id])

  @@index([graphSnapshotId])
}

model Edge {
  id              String   @id @default(uuid())
  graphSnapshotId String
  type            EdgeType
  fromNodeId      String
  toNodeId        String
  meta            Json?

  graphSnapshot GraphSnapshot @relation(fields: [graphSnapshotId], references: [id])

  @@index([graphSnapshotId])
}
